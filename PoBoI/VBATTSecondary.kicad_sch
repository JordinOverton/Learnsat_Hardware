	(text_box "Sizing Rtotal to be 1MΩ, 4S pack (12.0-16.8 V):\nOVoff = 17.5 V   (OVon ≈ 17.2 V, built-in hysteresis)\nUVon  = 12.4 V\nUVoff = 12.0 V   (3.0 V per cell)"
		(exclude_from_sim no)
		(at 17.78 113.8531 0)
		(size 38.1 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 150 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c814012a-b2a7-46b8-9b17-be6c88a07651")
	)
	(text_box "INA219 SHUNT VOLTAGE MEASUREMENT\n\nRSHUNT = 25 mOhm (R69)\nVSHUNT = ILOAD x RSHUNT\n\nAt 2A:\nVSHUNT = 2A x 0.025 Ohm = 50mV\n\nConfigured shunt range: +/-80mV\nEquivalent measurement range: +/-3.2A"
		(exclude_from_sim no)
		(at 35.56 30.48 0)
		(size 34.798 30.5285)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 150 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "de9bc08b-0f33-4395-bf55-d0835418faee")
	)
	(text_box "4S pack (12.0-16.8 V), Rtotal = 1 MΩ\n\nInputs: VOVOFF = 17.5 V, VUVON = 12.4 V, VUVOFF = 12.0 V\n\nR4 = (0.795/17.5)·1000          = 45.43k  → 45.3k\nR3 = (17.5/12.4 − 1)·R4         = 18.68k  → 18.7k\nR2 = (12.4/12.0 − 1)(17.5/12.4)·R4 = 2.137k → 2.15k\nR1 = (17.5/0.795 − 1)·R4 − R3 − R2 = 933.8k → 931k\n\nSum = 1000k"
		(exclude_from_sim no)
		(at 5.08 140.97 0)
		(size 66.04 22.4131)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 150 1)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f4cab7dd-0414-4d53-882c-6c1f87b1e5d7")
	)
